dist-ssr/
build/
out/
release/
server.js

# Tauri / Rust 构建产物
src-tauri/target/
*.pdb

# ==========================================
# 大文件与模型/运行时组件 (Large Models & Runtimes)
# 注意：GitHub 单文件限制 100MB，模型权重与嵌入式运行时请勿直接上传
# ==========================================
*.onnx
*.safetensors
*.pt
*.pth
*.bin
*.ckpt
assets/model/**/models/
assets/model/**/training_artifacts/
assets/tagger-runtime/
focus-sketch.zip
*.zip
*.tar.gz
*.7z
*.rar

# ==========================================
# 环境变量与敏感配置 (Environment & Secrets)
# ==========================================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ==========================================
# 日志与缓存 (Logs & Caches)

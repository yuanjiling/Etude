node_modules/
.pnpm-store/
package-lock.json.bak

# Python 虚拟环境与依赖
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

